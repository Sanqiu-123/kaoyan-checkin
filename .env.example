VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# DeepSeek AI 规划只在 Vercel Serverless API 中使用，不会暴露到浏览器前端。
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
# 可选：不填时默认使用 deepseek-v4-pro。
DEEPSEEK_MODEL=deepseek-v4-pro
# 可选：设为 true 时，会先请求 DeepSeek /models，自动优先选择版本号最高的 deepseek pro/flash 模型。
DEEPSEEK_AUTO_MODEL=false
# 强烈建议配置：保护 /api/ai-plan，避免他人消耗你的 DeepSeek 额度。网页首页也要输入同一个口令。
AI_ACCESS_CODE=change-this-private-code
